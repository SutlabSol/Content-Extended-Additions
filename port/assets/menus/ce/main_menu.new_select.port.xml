	<widget name="main_menu/new_select/list_item_0_map_kind_spinner" type="spinner" width="216" height="20" flags="left_right_tabs_items" string_list="main_menu/new_select/var_map_kinds" font="ui\small_ui" color="#FFB8DCFF" text_y="3" list_flags="items_from_strings" header_bitmap="bitmaps/arrow_sm_left" footer_bitmap="bitmaps/arrow_sm_right" header_bounds="3 -7 15 -1" footer_bounds="3 216 15 222">
