		<string text="S I N G L E P L A Y E R"/>
		<string text="M U L T I P L A Y E R"/>
		<string text="CUSTOM SINGLEPLAYER"/>
		<string text="CUSTOM MULTIPLAYER"/>
		<string text="DAILY CHALLENGES"/>
		<string text="F O R G E   M A P S"/>
	</strings>
	<widget name="main_menu/new_select/button_map_import" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" text="IMPORT MAP" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
